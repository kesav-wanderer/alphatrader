# Kite Connect (Zerodha) - get from https://developers.kite.trade
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=  # filled after login

# Paper trading mode (set to false only when ready for live)
PAPER_TRADE=true

# Data settings
DATA_DIR=./data/cache
MODELS_DIR=./models/saved
